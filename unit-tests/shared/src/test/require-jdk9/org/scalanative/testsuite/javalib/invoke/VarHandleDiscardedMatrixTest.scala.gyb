%{
# Generate both shapes with -D static=false or -D static=true.
is_static = static == 'true'
shape = 'Static' if is_static else 'Instance'
types = [
    ('Boolean', 'false', 'true'), ('Byte', '12.toByte', '3.toByte'),
    ('Short', '12.toShort', '3.toShort'), ('Char', '12.toChar', '3.toChar'),
    ('Int', '12', '3'), ('Long', '12L', '3L'),
    ('Float', '12.0f', '3.0f'), ('Double', '12.0d', '3.0d'),
    ('AnyRef', 'new String("initial")', 'new String("desired")')
]
prefixes = ['compareAndExchange', 'getAndSet', 'getAndAdd',
            'getAndBitwiseOr', 'getAndBitwiseAnd', 'getAndBitwiseXor']
methods = [prefix + suffix for prefix in prefixes for suffix in ['', 'Acquire', 'Release']]
}%
package org.scalanative.testsuite.javalib.invoke

// Generated from VarHandleDiscardedMatrixTest.scala.gyb; edit the template.
// format: off
import org.junit.Assert._
import org.junit.Test
import org.scalanative.testsuite.utils.AssertThrows.assertThrows

% for T, initial, desired in types:
%{
kind = 'Reference' if T == 'AnyRef' else T
fixture = 'VarHandle' + kind + shape + 'Fixture'
coordinate = '' if is_static else 'box, '
field = fixture + '.value' if is_static else 'box.value'
}%
class VarHandle${kind}${shape}DiscardedMatrixTest {
% for method in methods:
% for statement in [True, False]:
%{
add = method.startswith('getAndAdd')
bitwise = method.startswith('getAndBitwise')
unsupported = (add and T in ['Boolean', 'AnyRef']) or (bitwise and T in ['Float', 'Double', 'AnyRef'])
operands = 'initial, desired' if method.startswith('compareAndExchange') else 'desired'
invocation = 'handle.' + method + '(' + coordinate + operands + ')'
if add:
    expected = '(initial + desired).to' + T
elif bitwise:
    operator = '|' if method.startswith('getAndBitwiseOr') else '&' if method.startswith('getAndBitwiseAnd') else '^'
    expected = '(initial ' + operator + ' desired)' + ('' if T == 'Boolean' else '.to' + T)
else:
    expected = 'desired'
}%
  @Test def ${method}_${'statement' if statement else 'unitBody'}(): Unit = {
% if not is_static:
    val box = new ${fixture}
% end
    val handle = ${fixture if is_static else 'box'}.handle
    val initial: ${T} = ${initial}
    val desired: ${T} = ${desired}
    ${field} = initial
% if unsupported:
% if statement:
    assertThrows(classOf[UnsupportedOperationException], {
      ${invocation}
      ()
    })
% else:
    def invoke(): Unit = ${invocation}
    assertThrows(classOf[UnsupportedOperationException], invoke())
% end
% else:
% if statement:
    ${invocation}
% else:
    def invoke(): Unit = ${invocation}
    invoke()
% end
% end
% if T == 'AnyRef':
    assertSame(${'initial' if unsupported else expected}, ${field})
% elif T in ['Float', 'Double']:
    assertEquals(${'initial' if unsupported else expected}, ${field}, ${'0.0f' if T == 'Float' else '0.0d'})
% else:
    assertEquals(${'initial' if unsupported else expected}, ${field})
% end
  }
% end
% end
}
% end
