# =============================================================================
# GC Soft References Tests
# =============================================================================
# Fills most of a heap with a hard upper bound with softly reachable arrays,
# checks that collections keep them while memory is available, and that they
# are cleared and enqueued before an allocation fails with OutOfMemoryError.

# -----------------------------------------------------------------------------
# Phase 1: Run with Immix GC
# -----------------------------------------------------------------------------
> set nativeConfig ~= { _.withGC(scala.scalanative.build.GC.immix) }
> runSoftReferences

# -----------------------------------------------------------------------------
# Phase 2: Run with Commix GC
# -----------------------------------------------------------------------------
> set nativeConfig ~= { _.withGC(scala.scalanative.build.GC.commix) }
> runSoftReferences

# -----------------------------------------------------------------------------
# Phase 3: Run with Immix GC without multithreading
# -----------------------------------------------------------------------------
> set nativeConfig ~= { _.withGC(scala.scalanative.build.GC.immix).withMultithreading(false) }
> runSoftReferences
